// 예외 처리 테스트
TEST_F(MyAsyncComponentTest, ExceptionHandling)
{
    auto test_logic = [&]() -> nx::awaitable<void>
    {
        try
        {
            // 예외를 발생시킬 수 있는 작업
            // co_await m_component->risky_operation();
            
            FAIL() << "Expected exception not thrown";
        }
        catch (const std::runtime_error& e)
        {
            // 예상된 예외
            EXPECT_STREQ(e.what(), "expected error message");
        }
        catch (...)
        {
            FAIL() << "Unexpected exception type";
        }
        
        co_return;
    };
    
    m_runner.run_sync(test_logic());
}

