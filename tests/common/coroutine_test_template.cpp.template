// 타임아웃이 있는 테스트
TEST_F(MyAsyncComponentTest, OperationWithTimeout)
{
    auto test_logic = [&]() -> nx::awaitable<void>
    {
        // 타임아웃 설정
        AsioSteadyTimer timer(
            m_runner.io_context(),
            nx::seconds(5));
        
        // 비동기 작업과 타이머 경쟁
        auto result = co_await (
            // m_component->long_operation() ||
            timer.async_wait(boost::asio::use_awaitable)
        );
        
        // 검증
        // EXPECT_TRUE(completed_in_time);
        
        co_return;
    };
    
    // 전체 테스트 타임아웃 30초
    m_runner.run_sync(test_logic(), nx::seconds(30));
}

